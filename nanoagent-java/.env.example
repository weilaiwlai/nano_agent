# ============================================================
# NanoAgent Java 环境配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
#
# 兼容 Python 项目的 .env 格式：
#   - REDIS_URL 自动解析为 REDIS_HOST/PORT/PASSWORD/DB
#   - DB_URL  自动解析为 DATABASE_URL(r2dbc)/USER/PASSWORD
#   - POSTGRES_* 自动映射到 DATABASE_*
# ============================================================

# -------------------- 运行环境 --------------------
ENVIRONMENT=development
DEBUG=false

# -------------------- Agent Service (端口 8080) --------------------
AGENT_PORT=8080
AGENT_HOST=0.0.0.0

# OpenAI API 兼容接口（DashScope / OpenAI / DeepSeek / Groq）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.5-plus
EMBEDDING_MODEL=text-embedding-v3

# LLM 网关安全白名单（逗号分隔，生产环境必填）
ALLOWED_LLM_BASE_URLS=https://dashscope.aliyuncs.com/compatible-mode/v1,https://api.openai.com/v1,https://api.deepseek.com/v1,https://api.groq.com/openai/v1

# 网络搜索（可选）
TAVILY_API_KEY=

# Redis（LLM 会话存储）—— 支持 REDIS_URL 或独立配置
# REDIS_URL 格式: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379/0
# 独立配置（优先于 REDIS_URL 解析结果）：
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# -------------------- MCP Server (端口 8000) --------------------
MCP_PORT=8000
MCP_HOST=0.0.0.0
MCP_REQUIRE_AUTH=true
MCP_SERVICE_TOKEN=dev_token_123456

# MCP 查询安全限制
MCP_QUERY_ROW_LIMIT=200
MCP_QUERY_TIMEOUT_MS=3000
MCP_SQL_MAX_LENGTH=4000
MCP_MAX_LOG_TEXT_LENGTH=240

# 数据库连接 —— 支持 DB_URL 自动解析 + POSTGRES_* 映射
# DB_URL 格式: postgresql+asyncpg://user:pass@host:port/dbname
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nanoagent
# 或使用独立配置：
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nanoagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -------------------- 报告 / 邮件 --------------------
REPORT_PROVIDER=mock
REPORT_ALLOWED_EMAIL_DOMAINS=
REPORT_MAX_CONTENT_CHARS=12000
REPORT_CONTENT_SOFT_LIMIT=8000
REPORT_SOFT_BODY_CHARS=2000
REPORT_SUMMARY_PREVIEW_CHARS=500
REPORT_ATTACH_OVERFLOW=true
REPORT_ATTACHMENT_PREFIX=nanoagent_report
REPORT_SUBJECT=NanoAgent 自动报告

# SMTP（仅 REPORT_PROVIDER=smtp 时需要）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# -------------------- 安全认证 --------------------
REQUIRE_API_AUTH=false
AGENT_API_KEYS=dev_token_123456
AUTH_REQUIRE_USER_SUB=false
AUTH_ALLOW_API_KEY_FALLBACK=false
AGENT_API_TOKEN=dev_token_123456

# JWT / OIDC
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_HS256_SECRET=change_me_local_jwt_hs256_secret
JWT_ALGORITHMS=RS256,ES256,HS256
JWT_LEEWAY_SECONDS=30

# CORS
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CORS_ALLOW_CREDENTIALS=true

# -------------------- Frontend (端口 8501) --------------------
FRONTEND_PORT=8501
FRONTEND_HOST=0.0.0.0
AGENT_API_BASE_URL=http://localhost:8080
PAGE_TITLE=NanoAgent

# -------------------- LLM 会话存储 (BYOK V2) --------------------
LLM_SESSION_MASTER_KEY=change_me_llm_session_master_key
LLM_SESSION_TTL_SECONDS=3600
LLM_SESSION_MAX_TTL_SECONDS=86400
REQUIRE_LLM_SESSION=true

# -------------------- AI Agent 工作流 --------------------
GRAPH_RECURSION_LIMIT=25
MAX_MODEL_HISTORY_MESSAGES=6
AUTO_MEMORY_MAX_LEN=120
EMAIL_DRAFT_TARGET_CHARS=2000
TOOL_PAYLOAD_MAX_LENGTH=400

# -------------------- 服务间通信 --------------------
MCP_BASE_URL=http://localhost:8000

# -------------------- 日志 --------------------
LOG_LEVEL=INFO
